<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="org.takoyaki.reportmaker.controller.EquipmentEditorDialogController" hgap="10" vgap="9"
          prefWidth="460" stylesheets="@modern-style.css" styleClass="card">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints minWidth="90"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <Label text="%equipment.nameRequired" GridPane.rowIndex="0"/>
    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    <Label text="%equipment.rating" GridPane.rowIndex="1"/>
    <TextField fx:id="ratingField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    <Label text="%equipment.class" GridPane.rowIndex="2"/>
    <TextField fx:id="classField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    <Label text="%equipment.manufacturer" GridPane.rowIndex="3"/>
    <TextField fx:id="manufacturerField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    <Label text="%equipment.model" GridPane.rowIndex="4"/>
    <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    <Label text="%equipment.serialNumber" GridPane.rowIndex="5"/>
    <TextField fx:id="serialField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    <Label text="%equipment.assetNumber" GridPane.rowIndex="6"/>
    <TextField fx:id="assetField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
</GridPane>
